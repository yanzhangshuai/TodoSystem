# cp .env.example .env，改掉前两项，然后 docker compose up -d --build

# 必填
POSTGRES_PASSWORD=change-me
JWT_SECRET_KEY=change-me-to-at-least-32-bytes-random-string

# 验证邮件里链接的前缀，改了 WEB_PORT 要同步改
PUBLIC_BASE_URL=http://localhost:8080

# 邮件。默认 File：邮件写成 .html 落进 emails 卷，验证链接同时打进日志，
# 不配 SMTP 也能把「注册 → 收信 → 验证」跑通。
# 要真发信就改成 Smtp 并填下面四项（163 用 25 端口，密码填「授权码」不是登录密码；
# 四项必须一起填 —— 只填用户名不填密码，后端启动时就会中止）。
EMAIL_PROVIDER=File
# EMAIL_FROM_ADDRESS=you@163.com
# EMAIL_SMTP_HOST=smtp.163.com
# EMAIL_SMTP_PORT=25
# EMAIL_SMTP_USERNAME=you@163.com
# EMAIL_SMTP_PASSWORD=

# 可选
# POSTGRES_DB=todo_system
# POSTGRES_USER=plotweaver
# DB_PORT=5432
# WEB_PORT=8080
# GOOGLE_CLIENT_ID=          # 换成自己的 OAuth 客户端时填，默认沿用 appsettings.json 里的值
# SEED_ENABLED=false
