{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "WriteTo": [
      { "Name": "Console" }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Jwt": {
    "Issuer": "WebAppIssuer",
    "Audience": "WebAppAudience",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },

  "Authentication": {
    "Google": {
      "ClientId": "738896916129-sn1k57i38n7u4i7l8006mhi5spmvud16.apps.googleusercontent.com",
      "ClientSecret": ""
    }
  },

  "Email": {
    "FromName": "TodoSystem",
    "VerificationTokenHours": 24,
    "ResendCooldownSeconds": 60,
    "FileOutputDirectory": "emails",
    "Smtp": {
      "Port": 587,
      "UseStartTls": true
    }
  },

  "AllowedHosts": "*"
}
